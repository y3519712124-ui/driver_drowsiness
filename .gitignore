### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-files
*.bclicense
*.flf
#Test results file
TestResults.xml

# Only publish project source from this mixed local folder.
/*
!/.gitignore
!/LICENSE
!/README.md
!/requirements.txt
!/config.py
!/main.py
!/diagnose_mic.py
!/diagnose_stt.py
!/启动.bat
!/src/
__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
*.log
